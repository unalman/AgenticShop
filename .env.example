# Copy to .env and adjust. Never commit .env — it is gitignored.
#
# DEVELOPMENT ONLY. Every value below is a hardcoded placeholder for the throwaway containers
# that docker-compose.yml runs on 127.0.0.1 — PostgreSQL and RabbitMQ. They are published in
# this repository on purpose and are not secrets:
#
#   - both containers are bound to the loopback interface, so neither is reachable off-machine
#   - the application connects with a least-privilege role, never the bootstrap superuser
#   - the data is disposable; `docker compose down -v` destroys it
#
# Do not reuse these values anywhere else, and do not paste real credentials into this
# file — put them in .env, which is not committed. A production deployment supplies
# ConnectionStrings__<Service> through the environment or a secret store; no appsettings
# file in this repository should ever contain one.

# Bootstrap superuser. Used by docker/postgres/init-dbs.sh to create databases and roles,
# and by `docker compose exec db psql` for administration. No application uses it.
POSTGRES_USER=agenticshop
POSTGRES_PASSWORD=local_only_bootstrap
POSTGRES_PORT=5432

# One login role per service. Each owns exactly one database and cannot connect to any
# other, which is what makes the service boundary enforced by PostgreSQL rather than
# assumed by convention. Run scripts/verify-db-isolation.sh to prove it.
CATALOG_DB_PASSWORD=local_only_catalog
STOCK_DB_PASSWORD=local_only_stock
ORDERING_DB_PASSWORD=local_only_ordering

# Broker credentials, created by the rabbitmq image on first boot from these two variables.
# Note the names: RabbitMQ's canonical pair is DEFAULT_USER / DEFAULT_PASS, and "PASS" is not
# a substring of "PASSWORD" — ComposeConfigurationTests' credential guard was widened to match
# an assignment shape precisely so this variable cannot slip past it with a literal value.
#
# The image's default vhost stays "/", and Phase 2 declares its exchanges and queues from
# application startup rather than from a mounted definitions file: topology is application
# concern, credentials are not, and declaring them at startup needs no administrator tag.
RABBITMQ_DEFAULT_USER=local_only_rabbit
RABBITMQ_DEFAULT_PASS=local_only_rabbit
RABBITMQ_PORT=5672
