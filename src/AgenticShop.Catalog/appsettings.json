{
  // Levels only. The pieces configuration cannot express — the exception filter, ambient
  // enrichment and the access-log severity policy — are in Logging/CatalogLogging.cs, and the
  // reasoning for each is recorded there.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",

        // Microsoft.EntityFrameworkCore.Update is silenced deliberately.
        //
        // EF Core logs every SaveChanges failure at Error level with a full stack trace before
        // rethrowing, but it cannot know whether the failure was handled. The result was that a
        // routine duplicate-SKU 409 — correctly classified and answered by CatalogExceptionHandler —
        // still emitted an Error-level entry, and a genuinely unhandled failure emitted two.
        //
        // Severity classification belongs to the exception handler, because only it knows whether
        // the error was handled. Nothing is lost: unhandled failures are logged by the handler at
        // Error with the exception object, which includes inner exceptions and stack traces.
        //
        // Fatal, not None. Serilog's LogEventLevel has no None member — that belongs to
        // Microsoft.Extensions.Logging.LogLevel — and an unrecognised name here is parsed as a level
        // switch, which throws at host build time and stops the service from starting. Fatal is the
        // effective equivalent because EF Core never logs at Fatal in this category. Stock and
        // Ordering still say "None" and are correct to: they use the built-in providers, and this
        // divergence ends when they migrate.
        "Microsoft.EntityFrameworkCore.Update": "Fatal",

        // Silenced for the same reason as Update, and it is the same problem wearing a different
        // category: EF Core logs a *failed* command here at Error, with the SQL text, before it
        // rethrows — so a routine duplicate-SKU 409 emitted an Error entry for something the handler
        // had already classified and answered as a client error.
        //
        // This was meant to be solved by a filter that inspected the exception and suppressed only
        // the failures the handler answers as 4xx. That cannot work, and the attempt is recorded so
        // it is not repeated: EF Core attaches no exception to this event at all (it logs from inside
        // RelationalCommand and rethrows separately), so there is nothing to inspect. Nor could
        // anything else distinguish the cases — EF writes the entry before the handler has run.
        //
        // What is lost is the literal SQL and parameter list for a genuine failure. Less than it
        // sounds like: the handler logs every failure with the full exception chain, and its
        // PostgresException formatting already surfaces SqlState plus table, column and constraint.
        // What is kept is the invariant that matters more — error logs are how an operator decides
        // whether to page, and a duplicate SKU must never appear in one.
        //
        // Warning is not enough here. A minimum-level override still admits Error, which is the
        // level this entry is written at; only Fatal excludes it. The Information entry EF writes
        // for every successful command is excluded by the same override.
        "Microsoft.EntityFrameworkCore.Database.Command": "Fatal"
      }
    }
  },
  "AllowedHosts": "*"
}
