<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>AgenticShop.Catalog</RootNamespace>
    <UserSecretsId>agenticshop-catalog</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Shared infrastructure, not a service. Directory.Build.targets exempts exactly this one
      project name from the cross-service reference ban; a reference to another service is still
      a build error.
    -->
    <ProjectReference Include="..\AgenticShop.Shared\AgenticShop.Shared.csproj" />
  </ItemGroup>

</Project>
