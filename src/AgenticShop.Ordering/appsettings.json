{
  // Levels only. The pieces configuration cannot express — ambient enrichment and the access-log
  // severity policy — are in AgenticShop.Shared/Logging/ServiceLogging.cs, and the reasoning for
  // each is recorded there.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",

        // Silenced deliberately.
        //
        // EF Core logs every SaveChanges failure at Error level with a full stack trace before
        // rethrowing, but it cannot know whether the failure was handled. Severity classification
        // belongs to the exception handler, because only it knows whether the error was handled.
        // Nothing is lost: unhandled failures are logged by the handler at Error with the exception
        // object, which includes inner exceptions and stack traces.
        //
        // Fatal, not None. Serilog's LogEventLevel has no None member — that belongs to
        // Microsoft.Extensions.Logging.LogLevel — and an unrecognised name here is parsed as a level
        // switch, which throws at host build time and stops the service from starting. Fatal is the
        // effective equivalent because EF Core never logs at Fatal in these categories.
        "Microsoft.EntityFrameworkCore.Update": "Fatal",

        // The sibling category, silenced for the same reason: EF Core logs a *failed* command here at
        // Error, with the SQL text, before it rethrows. A filter that suppressed only the failures
        // the handler answers as 4xx cannot exist — EF attaches no exception to this event, and it
        // writes the entry before the handler has run, so nothing on it says whether the failure will
        // be handled. The full reasoning, and what silencing costs, are in
        // docs/KNOWN-ISSUES.md -> Observability.
        //
        // Note that Warning would not do: a minimum-level override still admits Error, which is the
        // level this entry is written at. The Information entry EF writes for every *successful*
        // command is excluded by the same override.
        "Microsoft.EntityFrameworkCore.Database.Command": "Fatal",

        // Reduced to Warning for the same reason from the other direction: Ordering is the only
        // service that makes outbound calls, so it is the only one where a downstream failure would
        // otherwise be logged twice — once by the HTTP stack and once by the handler that classifies
        // it. The resilience pipeline's own retries and circuit breaks log under
        // Microsoft.Extensions.Http.Resilience and are deliberately left alone: a retry that
        // recovered is worth seeing, and it is not an error.
        "System.Net.Http.HttpClient": "Warning",

        // Silenced because a poller now exists: the compose healthcheck probes /health every ten
        // seconds, and DefaultHealthCheckService writes one Error per unhealthy check per probe. This
        // is the revisit docs/KNOWN-ISSUES.md asked for when a poller arrived.
        //
        // Ordering is where the multiplication would have been worst, because it registers three
        // checks rather than one — database, Catalog and Stock. Note the split limits the damage
        // anyway: compose polls /health, which runs only the database check, so a downstream outage
        // produces these Errors solely when something polls /health/ready. Silencing the category
        // covers both.
        //
        // What survives, measured: the access log records every probe with its status and duration.
        // The failing check's name does not reach Docker's own record — the healthcheck runs
        // `curl -fsS`, and `-f` is what makes a 503 fail the probe at all, but it also discards the
        // body, so `docker inspect` retains `curl: (22) ... error: 503` and nothing else. The name is
        // still one request away, in the body of `/health`, and it is the one detail worth naming
        // here: Ordering has three checks, so "which one" is a real question rather than a formality.
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Fatal"
      }
    }
  },
  "AllowedHosts": "*"
}
