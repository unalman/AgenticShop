{
  // DEVELOPMENT ONLY. This is the placeholder password published in .env.example for the
  // local PostgreSQL container, which is bound to 127.0.0.1 and holds disposable data.
  // It is not a secret and must never appear in a non-Development configuration file.
  // Override locally with `dotnet user-secrets` (UserSecretsId: agenticshop-stock) or
  // the ConnectionStrings__Stock environment variable; production supplies it that way.
  "ConnectionStrings": {
    "Stock": "Host=localhost;Port=5432;Database=agenticshop_stock;Username=stock_svc;Password=local_only_stock"
  },
  // DEVELOPMENT ONLY, for the same reason as the connection string above: these are the published
  // placeholder credentials from .env.example, for a broker bound to 127.0.0.1 and holding
  // disposable data. A real environment supplies RabbitMq__Url; startup fails if it is absent, which
  // is what keeps this value out of every non-Development configuration file.
  //
  // Port 5672 is the one docker-compose.yml publishes on the loopback interface, so a host process
  // reaches the same broker the containerised services do.
  "RabbitMq": {
    "Url": "amqp://local_only_rabbit:local_only_rabbit@localhost:5672/"
  }

  // The Logging section that used to live here is gone, not relocated. Serilog is now the only
  // logging provider, it reads the Serilog section, and the base appsettings.json carries every
  // override this file used to — including the Database.Command level, which was previously
  // Development-only and left a non-Development run logging every successful SQL command.
}
